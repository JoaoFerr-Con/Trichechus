@using Trichechus.Frontend.Infrastructure.Services
@using Trichechus.Frontend.Shared.DTOs
@inject Radzen.DialogService DialogService

@inject HttpClient Http
@inject AtividadeService AtividadeService
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="UpdateAtividadeDto" Data="@model" Submit="@SalvarAtividade">
    <RadzenRow Class="gy-2">
        <!-- Título / Prazo -->
        <RadzenColumn Size="6">
            <RadzenFormField Text="Título" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@model.Titulo" Name="Titulo" Style="width: 100%; height: 38px;" />
                <RadzenRequiredValidator Component="Titulo" Text="O título é obrigatório" />
            </RadzenFormField>
        </RadzenColumn>

        <RadzenColumn Size="6">
            <RadzenFormField Text="Prazo" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDatePicker @bind-Value="@model.Prazo" DateFormat="dd/MM/yyyy" Style="width: 100%; height: 38px;" />
                <RadzenRequiredValidator Component="Prazo" Text="O prazo é obrigatório" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- Situação / Responsável -->
        <RadzenColumn Size="6">
            <RadzenFormField Text="Situação" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDropDown @bind-Value="@model.Situacao" Data="@situacoes" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <RadzenColumn Size="6">
            <RadzenFormField Text="Responsável" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@model.NomeResponsavel" Name="NomeResponsavel" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- Tipo de Entrada / Equipe Responsável -->
        <RadzenColumn Size="6">
            <RadzenFormField Text="Tipo de Entrada" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDropDown @bind-Value="@model.TipoEntrada" Data="@tiposEntrada" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <RadzenColumn Size="6">
            <RadzenFormField Text="Equipe Responsável" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@model.NomeEquipeResponsavel" Name="NomeEquipeResponsavel" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- Descrição (linha inteira) -->
        <RadzenColumn Size="12">
            <RadzenFormField Text="Descrição" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextArea @bind-Value="@model.Descricao" Rows="5" Style="width: 100%; height: 100px;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <!-- Botões -->
    <div class="d-flex justify-content-end mt-4">
        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Text="Cancelar" Click="@Cancel" class="me-2" />
        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Salvar" />
    </div>
</RadzenTemplateForm>

@code {
	[Parameter] public Guid AtividadeId { get; set; }
	[Parameter] public string? UserName { get; set; }
	
	private UpdateAtividadeDto model = new UpdateAtividadeDto();
	private IEnumerable<string> situacoes = new List<string> { "Pendente", "Em Andamento", "Concluída", "Cancelada" };
	private IEnumerable<string> tiposEntrada = new List<string> { "Manual", "Importação", "Sistema" };
	
	protected override async Task OnInitializedAsync()
	{
		try
		{
			var atividade = await AtividadeService.GetAtividadeByIdAsync(AtividadeId);
			model.Id = AtividadeId;
			model.Titulo = atividade.Titulo;
			model.Descricao = atividade.Descricao;
			model.Situacao = atividade.Situacao;
			model.NomeResponsavel = atividade.NomeResponsavel;
			model.Prazo = atividade.Prazo;
			model.NomeEquipeResponsavel = atividade.NomeEquipeResponsavel;
			model.TipoEntrada = atividade.TipoEntrada;
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Erro", $"Erro ao carregar atividade: {ex.Message}");
			DialogService.Close();
		}
	}
	
	private async Task OnSubmit()
	{
		try
		{
			await AtividadeService.UpdateAtividadeAsync(AtividadeId, model);
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Erro", $"Erro ao atualizar atividade: {ex.Message}");
		}
	}
	
	private void Cancel()
	{
		DialogService.Close();
	}
	
	private async Task SalvarAtividade()
	{
		try
		{
			var response = await Http.PutAsJsonAsync($"api/atividades/{AtividadeId}", model);

			if (!response.IsSuccessStatusCode)
			{
				var content = await response.Content.ReadAsStringAsync();
				var mensagemErro = ErrorFormatter.FormatApiProblemDetails(content);

				await DialogService.OpenAsync("Erro ao salvar", ds =>
				@<div style="white-space:pre-wrap">@mensagemErro</div>,
				new Radzen.DialogOptions { Width = "600px", CloseDialogOnOverlayClick = true }
			);

				return;
			}

			DialogService.Close(true); // ou redirecionar, ou notificar sucesso
		}
		catch (Exception ex)
		{
			await DialogService.OpenAsync("Erro inesperado", ds =>
			@<div>@ex.Message</div>,
			new Radzen.DialogOptions { Width = "600px" }
		);
		}
	}

}
