@using Trichechus.Frontend.Infrastructure.Services
@using Trichechus.Frontend.Shared.DTOs
@inject TarefaService TarefaService
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="CreateTarefaDto" Data="@model" Submit="@OnSubmit">
    <RadzenRow Class="gy-2">
        <!-- Título / Atividade -->
        <RadzenColumn Size="6">
            <RadzenFormField Text="Título" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@model.Titulo" Name="Titulo" Style="width: 100%; height: 38px;" />
                <RadzenRequiredValidator Component="Titulo" Text="O título é obrigatório" />
            </RadzenFormField>
        </RadzenColumn>

        <RadzenColumn Size="6">
            <RadzenFormField Text="Atividade" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDropDown @bind-Value="@model.AtividadeId" Data="@Atividades" TextProperty="Titulo" ValueProperty="Id" Style="width: 100%; height: 38px;" />
                <RadzenRequiredValidator Component="AtividadeId" Text="A atividade é obrigatória" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- Situação / Responsável -->
        <RadzenColumn Size="6">
            <RadzenFormField Text="Situação" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDropDown @bind-Value="@model.Situacao" Data="@situacoes" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <RadzenColumn Size="6">
            <RadzenFormField Text="Responsável" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@model.NomeResponsavel" Name="NomeResponsavel" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- Prazo / Descrição -->
        <RadzenColumn Size="6">
            <RadzenFormField Text="Prazo" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDatePicker @bind-Value="@model.Prazo" Name="Prazo" DateFormat="dd/MM/yyyy" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

		<RadzenColumn Size="6">
            <RadzenFormField Text="Descrição" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextArea @bind-Value="@model.Descricao" Name="Descricao" Rows="3" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>
        

        <!-- Observação (linha completa) -->
        <RadzenColumn Size="12">
            <RadzenFormField Text="Observação" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextArea @bind-Value="@model.Observacao" Name="Observacao" Rows="3" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <!-- Botões -->
    <div class="d-flex justify-content-end mt-4">
        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Text="Cancelar" Click="@Cancel" class="me-2" />
        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Salvar" />
    </div>
</RadzenTemplateForm>

@code {
    [Parameter] public IEnumerable<AtividadeDto>? Atividades { get; set; }
    [Parameter] public string? UserName { get; set; }
    
    private CreateTarefaDto model = new CreateTarefaDto();
    private IEnumerable<string> situacoes = new List<string> { "Pendente", "Em Andamento", "Concluída", "Cancelada" };
    
    protected override void OnInitialized()
    {
        model.NomeResponsavel = UserName;
        model.Situacao = "Pendente";
        
        if (Atividades != null && Atividades.Any())
        {
            model.AtividadeId = Atividades.First().Id;
        }
    }
    
    private async Task OnSubmit()
    {
        try
        {
            await TarefaService.CreateTarefaAsync(model);
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erro", $"Erro ao criar tarefa: {ex.Message}");
        }
    }
    
    private void Cancel()
    {
        DialogService.Close();
    }
}
