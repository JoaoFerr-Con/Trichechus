@using Trichechus.Frontend.Infrastructure.Services
@using Trichechus.Frontend.Shared.DTOs
@inject AtividadeService AtividadeService
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="CreateAtividadeDto" Data="@model" Submit="@OnSubmit">
    <RadzenRow Class="gy-2">

        <!-- Título / Prazo -->
        <RadzenColumn Size="6">
            <RadzenFormField Text="Título" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@model.Titulo" Name="Titulo" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <RadzenColumn Size="6">
            <RadzenFormField Text="Prazo" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDatePicker @bind-Value="@model.Prazo" DateFormat="dd/MM/yyyy" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- Situação / Responsável -->
        <RadzenColumn Size="6">
            <RadzenFormField Text="Situação" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDropDown @bind-Value="@model.Situacao" Data="@situacoes" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <RadzenColumn Size="6">
            <RadzenFormField Text="Responsável" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@model.NomeResponsavel" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- Tipo de Entrada / Equipe Responsável -->
        <RadzenColumn Size="6">
            <RadzenFormField Text="Tipo de Entrada" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenDropDown @bind-Value="@model.TipoEntrada" Data="@tiposEntrada" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <RadzenColumn Size="6">
            <RadzenFormField Text="Equipe Responsável" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@model.NomeEquipeResponsavel" Style="width: 100%; height: 38px;" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- Descrição (linha inteira) -->
        <RadzenColumn Size="12">
            <RadzenFormField Text="Descrição" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextArea @bind-Value="@model.Descricao" Rows="5" Style="width: 100%; height: 100px;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <!-- Botões -->
    <div class="d-flex justify-content-end mt-4">
        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Text="Cancelar" Click="@Cancel" class="me-2" />
        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Salvar" BusyText="Salvando..." IsBusy="@isBusy" />
    </div>
</RadzenTemplateForm>

@code {
	[Parameter] public string? UserName { get; set; }
	
	private CreateAtividadeDto model = new CreateAtividadeDto();
	private IEnumerable<string> situacoes = new List<string> { "Pendente", "Em Andamento", "Concluída", "Cancelada" };
	private IEnumerable<string> tiposEntrada = new List<string> { "Manual", "Importação", "Sistema" };
	private bool isBusy = false;
	
	protected override void OnInitialized()
	{
		model.NomeResponsavel = UserName;
		model.Situacao = "Pendente";
		model.Prazo = DateTime.Now.AddDays(7);
	}
	
	private async Task OnSubmit()
	{
		try
		{
			isBusy = true;
			await AtividadeService.CreateAtividadeAsync(model);
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Erro", $"Erro ao criar atividade: {ex.Message}");
			isBusy = false;
		}
	}
	
	private void Cancel()
	{
		DialogService.Close();
	}
}
