@using Trichechus.Frontend.Infrastructure.Services
@using Trichechus.Frontend.Shared.DTOs
@inject AtividadeService AtividadeService
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="CreateAtividadeDto" Data="@model" Submit="@OnSubmit" style="height: 100%">
	<div class="container" style="height: 100%; display: flex; flex-direction: column;">
		<div class="row flex-grow-1" style="overflow-y: auto;">
			<div class="col-md-12">
				<div class="row">
					<div class="col-md-12 mb-3">
						<RadzenFormField Text="Título" Variant="Variant.Filled">
							<RadzenTextBox @bind-Value="@model.Titulo" Name="Titulo" class="w-100" />
							<RadzenRequiredValidator Component="Titulo" Text="O título é obrigatório" Popup="true" />
							<RadzenLengthValidator Component="Titulo" Max="200" Text="O título não pode ter mais de 200 caracteres" Popup="true" />
						</RadzenFormField>
					</div>
				</div>
				
				<div class="row">
					<div class="col-md-12 mb-3">
						<RadzenFormField Text="Descrição" Variant="Variant.Filled">
							<RadzenTextArea @bind-Value="@model.Descricao" Name="Descricao" class="w-100" Rows="5" />
							<RadzenLengthValidator Component="Descricao" Max="1000" Text="A descrição não pode ter mais de 1000 caracteres" Popup="true" />
						</RadzenFormField>
					</div>
				</div>
				
				<div class="row">
					<div class="col-md-6 mb-3">
						<RadzenFormField Text="Situação" Variant="Variant.Filled">
							<RadzenDropDown @bind-Value="@model.Situacao" Data="@situacoes" class="w-100" />
						</RadzenFormField>
					</div>
					<div class="col-md-6 mb-3">
						<RadzenFormField Text="Responsável" Variant="Variant.Filled">
							<RadzenTextBox @bind-Value="@model.NomeResponsavel" Name="NomeResponsavel" class="w-100" />
						</RadzenFormField>
					</div>
				</div>
				
				<div class="row">
					<div class="col-md-6 mb-3">
						<RadzenFormField Text="Prazo" Variant="Variant.Filled">
							<RadzenDatePicker @bind-Value="@model.Prazo" Name="Prazo" class="w-100" DateFormat="dd/MM/yyyy" />
							<RadzenRequiredValidator Component="Prazo" Text="O prazo é obrigatório" Popup="true" />
						</RadzenFormField>
					</div>
					<div class="col-md-6 mb-3">
						<RadzenFormField Text="Equipe Responsável" Variant="Variant.Filled">
							<RadzenTextBox @bind-Value="@model.NomeEquipeResponsavel" Name="NomeEquipeResponsavel" class="w-100" />
						</RadzenFormField>
					</div>
				</div>
				
				<div class="row">
					<div class="col-md-6 mb-3">
						<RadzenFormField Text="Tipo de Entrada" Variant="Variant.Filled">
							<RadzenDropDown @bind-Value="@model.TipoEntrada" Data="@tiposEntrada" class="w-100" />
						</RadzenFormField>
					</div>
				</div>
			</div>
		</div>
		
		<div class="row mt-3">
			<div class="col-md-12 d-flex justify-content-end">
				<RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Text="Cancelar" Click="@Cancel" class="me-2" />
				<RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Salvar" BusyText="Salvando..." IsBusy="@isBusy" />
			</div>
		</div>
	</div>
</RadzenTemplateForm>

@code {
	[Parameter] public string? UserName { get; set; }
	
	private CreateAtividadeDto model = new CreateAtividadeDto();
	private IEnumerable<string> situacoes = new List<string> { "Pendente", "Em Andamento", "Concluída", "Cancelada" };
	private IEnumerable<string> tiposEntrada = new List<string> { "Manual", "Importação", "Sistema" };
	private bool isBusy = false;
	
	protected override void OnInitialized()
	{
		model.NomeResponsavel = UserName;
		model.Situacao = "Pendente";
		model.Prazo = DateTime.Now.AddDays(7);
	}
	
	private async Task OnSubmit()
	{
		try
		{
			isBusy = true;
			await AtividadeService.CreateAtividadeAsync(model);
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Erro", $"Erro ao criar atividade: {ex.Message}");
			isBusy = false;
		}
	}
	
	private void Cancel()
	{
		DialogService.Close();
	}
}
