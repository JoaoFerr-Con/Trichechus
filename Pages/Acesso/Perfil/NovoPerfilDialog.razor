@using Trichechus.Frontend.Infrastructure.Services
@using Trichechus.Frontend.Shared.DTOs
@inject PerfilService PerfilService
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="CreatePerfilDto" Data="@model" Submit="@OnSubmit">
	<RadzenRow>
		<RadzenColumn Size="12">
			<RadzenCard Style="max-width: 700px; margin: auto; box-shadow: 0 10px 20px rgba(0,0,0,0.1); padding: 24px;">
				<ChildContent>
					<RadzenStack Orientation="Orientation.Vertical" Gap="16px">

						<!-- Campo Nome -->
						<RadzenFormField Text="Nome" Variant="Variant.Outlined">
							<Start>
								<RadzenIcon Icon="account_circle" />
							</Start>
							<ChildContent>
								<RadzenTextBox @bind-Value="@model.Nome" Name="Nome" Style="width: 100%;" />
								<RadzenRequiredValidator Component="Nome" Text="O Nome é obrigatório" />
							</ChildContent>
						</RadzenFormField>

						<!-- Campo Descrição -->
						<RadzenFormField Text="Descrição" Variant="Variant.Outlined">
							<ChildContent>
								<RadzenTextArea @bind-Value="@model.Descricao" Name="Descricao" Rows="3" Style="width: 100%;" />
							</ChildContent>
						</RadzenFormField>

						<!-- Botões -->
						<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="12px">
							<RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Text="Cancelar" Click="@Cancel" />
							<RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Salvar" />
						</RadzenStack>
					</RadzenStack>
				</ChildContent>
			</RadzenCard>
		</RadzenColumn>
	</RadzenRow>
</RadzenTemplateForm>

@code {
	private CreatePerfilDto model = new CreatePerfilDto();

	private async Task OnSubmit()
	{
		try
		{
			await PerfilService.CreatePerfilAsync(model);
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Erro", $"Erro ao criar perfil: {ex.Message}");
		}
	}

	private void Cancel()
	{
		DialogService.Close();
	}
}