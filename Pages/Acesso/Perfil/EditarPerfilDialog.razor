@using Trichechus.Frontend.Infrastructure.Services
@using Trichechus.Frontend.Shared.DTOs
@inject PerfilService PerfilService
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="UpdatePerfilDto" Data="@model" Submit="@OnSubmit">
    <RadzenRow Justify="Justify.Center">
        <RadzenColumn Size="12">
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Vertical" Gap="20px">

                    <!-- Campo Nome com ícone -->
                    <RadzenFormField Text="Nome" Variant="Variant.Outlined">
                        <Start>
                            <RadzenIcon Icon="account_circle" />
                        </Start>
                        <ChildContent>
                            <RadzenTextBox @bind-Value="@model.Nome" Name="Nome" Style="width: 100%;" />
                        </ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="Nome" Text="O Nome é obrigatório" />
                        </Helper>
                    </RadzenFormField>

                    <!-- Campo Descrição -->
                    <RadzenFormField Text="Descrição" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@model.Descricao" Name="Descricao" Rows="3" Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Botões -->
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="10px">
                        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Text="Cancelar" Click="@Cancel" />
                        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Salvar" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenTemplateForm>

@code {
	[Parameter] public Guid PerfilId { get; set; }
	
	private UpdatePerfilDto model = new UpdatePerfilDto();
	@* private IEnumerable<string> situacoes = new List<string> { "Pendente", "Em Andamento", "Concluída", "Cancelada" }; *@
	
	protected override async Task OnInitializedAsync()
	{
		try
		{
			var perfil = await PerfilService.GetPerfilByIdAsync(PerfilId);
			model.Nome = perfil.Nome;
			model.Descricao = perfil.Descricao;
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Erro", $"Erro ao carregar perfil: {ex.Message}");
			DialogService.Close();
		}
	}
	
	private async Task OnSubmit()
	{
		try
		{
			await PerfilService.UpdatePerfilAsync(PerfilId, model);
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Erro", $"Erro ao atualizar perfil: {ex.Message}");
		}
	}
	
	private void Cancel()
	{
		DialogService.Close();
	}
}
