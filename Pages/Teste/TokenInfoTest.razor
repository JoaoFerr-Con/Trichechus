@page "/token-info-test"
@inject Trichechus.Frontend.Infrastructure.Services.LocalStorageService LocalStorage
@inject HttpClient HttpClient

<h3>Informações de Autenticação</h3>

<RadzenButton Text="Carregar Dados do Token" Click="@CarregarDados" Style="margin-bottom: 1rem;" />

@if (!string.IsNullOrEmpty(token))
{
	<div class="mb-3">
		<b>Token:</b>
		<textarea readonly style="width: 100%; height: 150px;">@token</textarea>
	</div>

	<div><b>Expiração:</b> @expiracao</div>
	<div><b>Usuário:</b> @usuario</div>

	<div class="mt-3"><b>Authorization Header (HttpClient):</b></div>
	<pre>@HttpClient.DefaultRequestHeaders.Authorization?.ToString()</pre>
}
else if (carregado)
{
	<p style="color:red">⚠ Nenhum token encontrado no localStorage.</p>
}

@code {
	private string? token;
	private string? expiracao;
	private string? usuario;
	private bool carregado = false;

	private async Task CarregarDados()
	{
		carregado = true;

		token = await LocalStorage.GetItemAsync<string>("authToken");
		expiracao = await LocalStorage.GetItemAsync<string>("authExpiration");
		usuario = await LocalStorage.GetItemAsync<string>("authUser");
	}
}