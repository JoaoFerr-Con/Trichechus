@code {
	public bool IsLoading { get; private set; }
	public string? LoadingMessage { get; private set; }

	public void ShowLoading(string message = "")
	{
		IsLoading = true;
		LoadingMessage = message;
		StateHasChanged();
	}

	public void HideLoading()
	{
		IsLoading = false;
		LoadingMessage = "";
		StateHasChanged();
	}
}