@using Microsoft.AspNetCore.Components.Web
@inherits ErrorBoundaryBase

@if (CurrentException is null)
{
	@ChildContent
}
else
{
	<div class="error-ui">
		<div class="error-container">
			<RadzenIcon Icon="error" Style="font-size: 3rem; color: var(--rz-danger);" />
			<h3 class="mt-3">Ocorreu um erro</h3>
			<p>Desculpe, ocorreu um erro inesperado.</p>
			
			<div class="error-details">
				<p><strong>Erro:</strong> @CurrentException.Message</p>
				@if (ShowDetails)
				{
					<pre>@CurrentException.StackTrace</pre>
				}
			</div>
			
			<div class="d-flex justify-content-center mt-4">
				<RadzenButton Text="Mostrar Detalhes" ButtonStyle="ButtonStyle.Secondary" Click="@ToggleDetails" class="me-2" />
				<RadzenButton Text="Tentar Novamente" ButtonStyle="ButtonStyle.Primary" Click="@(() => Recover())" />
			</div>
		</div>
	</div>
}

<style>
	.error-ui {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(255, 255, 255, 0.9);
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 9999;
	}
	
	.error-container {
		text-align: center;
		background-color: white;
		padding: 2rem;
		border-radius: 8px;
		box-shadow: 0 5px 20px rgba(0,0,0,0.1);
		max-width: 600px;
		width: 90%;
	}
	
	.error-details {
		text-align: left;
		margin: 1rem 0;
		padding: 1rem;
		background-color: #f8f9fa;
		border-radius: 4px;
		max-height: 300px;
		overflow-y: auto;
	}
	
	.error-details pre {
		white-space: pre-wrap;
		font-size: 0.8rem;
	}
</style>

@code {
	private bool ShowDetails { get; set; } = false;
	
	protected override Task OnErrorAsync(Exception exception)
	{
		// Aqui você pode registrar/logar o erro se quiser.
		Console.WriteLine($"Erro capturado no ErrorBoundary: {exception.Message}");
		return Task.CompletedTask;
	}
	
	private void ToggleDetails()
	{
		ShowDetails = !ShowDetails;
	}
}
